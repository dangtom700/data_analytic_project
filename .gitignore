# ─────────────────────────────────────────────────────────────────────────────
# Datasets — never committed. Re-create with:  python data_download.py
# (see docs/DATASETS.md for the two datasets that need a manual download)
#
# Everything under data/ is ignored EXCEPT the per-dataset README.md files,
# which are the documentation for data we don't store in git.
# ─────────────────────────────────────────────────────────────────────────────
data/**
# ...but never ignore work we wrote ourselves. The datasets under data/ are all
# re-downloadable via data_download.py (Kaggle handles, idempotent), so the bulk
# is deliberately untracked. Notebooks, scripts and per-dataset notes are NOT
# re-downloadable and must stay in git.
!data/**/
!data/**/*.py
!data/**/*.ipynb
!data/**/*.md
!data/**/*.m
!data/**/
!data/**/README.md

# Third-party reference catalogue, cloned not authored.
# Source: github.com/dalmia/awesome-industrial-datasets
awesome-industrial-datasets-master/

# Course lab submission bundles — the extracted work is already in archive/
archive/**/*.zip

# ─── Data file types, wherever they land ───
*.csv
*.tsv
*.parquet
*.wav
*.txt
*.pkl
*.joblib
*.bdf
*.db
*.db-shm
*.db-wal
*.h5
*.hdf5
*.npy
*.npz
# ...but keep dependency and doc text files
!requirements*.txt
!LICENSE*.txt

# ─── Python ───
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/

# ─── Editors / OS ───
.DS_Store
Thumbs.db
desktop.ini

# pip install --target artifacts (the .pyd is already covered by *.py[cod])
controller_toolbox-*.dist-info/

# local backups of this file
.gitignore.bak-*
